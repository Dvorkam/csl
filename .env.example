# Copy to .env and fill in values before starting the server.
# Never commit .env — it is gitignored.

# Path to the AES-256-GCM master key file (used to encrypt SSH keys at rest).
CSL_MASTER_KEY_PATH=secrets/master.key

# Path to the JWT signing key file.
CSL_JWT_KEY_PATH=secrets/jwt.key

# SQLite database file path.
CSL_DATABASE_URL=sqlite+aiosqlite:///data/control-station.sqlite

# Bind address for the FastAPI server (uvicorn).
CSL_HOST=127.0.0.1
CSL_PORT=8000

# Log level: DEBUG | INFO | WARNING | ERROR
CSL_LOG_LEVEL=INFO

# Set the Secure flag on auth cookies. Leave true in production (nginx/TLS).
# Set to false for local development over plain HTTP, or the browser will drop
# the login cookies.
CSL_COOKIE_SECURE=true
